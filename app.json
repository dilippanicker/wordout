{
  "expo": {
    "name": "Wordout",
    "slug": "wordout",
    "version": "1.7.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "wordout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.dilippanicker.wordout",
      "versionCode": 37,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8EE"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFF8EE"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/wordout/play"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "da8c4ab9-2b9d-46d8-aa00-6d1ea4bd373b"
      }
    },
    "owner": "dilippanicker"
  }
}
